# Backend
DATABASE_URL="postgresql://postgres:<PASSWORD>@db.<PROJECT>.supabase.co:5432/postgres?sslmode=require"
PORT=3001
NODE_ENV=development

# Frontend (admin)
VITE_API_URL=http://localhost:3001
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_API_KEY=
VITE_CLOUDINARY_API_SECRET=

# Scientia Helpdesk RAG
GEMINI_API_KEY=
VOYAGE_API_KEY=

QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=scientia_helpdesk

RAG_EMBEDDING_PROVIDER=voyage
RAG_EMBEDDING_MODEL=voyage-4-lite
RAG_EMBEDDING_DIMENSION=1024

RAG_LLM_PROVIDER=gemini
RAG_LLM_MODEL=gemini-3.6-flash

RAG_TOP_K_DENSE=20
RAG_TOP_K_SPARSE=20
RAG_TOP_K_FUSED=20
RAG_TOP_K_FINAL=5
RAG_MIN_DENSE_SCORE=0.3
RAG_MIN_SPARSE_SCORE=0.5

RAG_CHUNK_TARGET_TOKENS=600
RAG_CHUNK_MAX_TOKENS=900
RAG_CHUNK_MIN_TOKENS=100

RAG_CACHE_ENABLED=true
RAG_CACHE_TTL_SECONDS=3600

RAG_MAX_DOCUMENT_SIZE_MB=50
