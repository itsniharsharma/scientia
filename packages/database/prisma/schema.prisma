generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Subject {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  chapters  Chapter[]
  tests     Test[]

  @@map("subjects")
}

model Chapter {
  id        String   @id @default(uuid())
  subjectId String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject   Subject  @relation(fields: [subjectId], references: [id])
  topics    Topic[]

  @@unique([subjectId, name])
  @@map("chapters")
}

model Topic {
  id        String   @id @default(uuid())
  chapterId String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapter   Chapter    @relation(fields: [chapterId], references: [id])
  questions  Question[]
  uploadJobs UploadJob[]

  @@unique([chapterId, name])
  @@map("topics")
}

enum QuestionType {
  SINGLE_CHOICE
  MULTI_CHOICE
  INTEGER
}

enum UploadSource {
  TELEGRAM
  WEB_ADMIN
  ANDROID
  IOS
  BULK_IMPORT
}

enum UploadJobStatus {
  RECEIVED
  VALIDATING
  DOWNLOADING
  COMPRESSING
  UPLOADING
  CREATING_QUESTION
  COMPLETED
  FAILED
  ORPHANED
}

enum QuestionStatus {
  DRAFT
  PUBLISHED
}

model Question {
  id               String         @id @default(uuid())
  topicId          String
  type             QuestionType
  status           QuestionStatus @default(DRAFT)
  questionText     String?
  questionImageUrl String?
  latexContent     String?        @db.Text
  integerAnswer    Int?
  appearanceCount  Int            @default(0)
  lastAppearedAt   DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  topic         Topic          @relation(fields: [topicId], references: [id])
  options       Option[]
  testQuestions TestQuestion[]
  uploadJob     UploadJob?

  @@index([topicId, status])
  @@index([status, appearanceCount])
  @@map("questions")
}

model Option {
  id             String  @id @default(uuid())
  questionId     String
  position       Int
  optionText     String?
  optionImageUrl String?
  latexContent   String? @db.Text
  isCorrect      Boolean @default(false)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, position])
  @@map("options")
}

// ─── Auth ────────────────────────────────────────────────────────────────────

enum UserRole {
  TEACHER
  STUDENT
}

// Global username registry: the single source of truth for username
// uniqueness across BOTH Teacher and Student. A row here is created
// atomically alongside every Teacher/Student row so the same username can
// never be claimed by both a student and a teacher.
enum UsernameOwnerType {
  STUDENT
  TEACHER
}

model Username {
  username  String            @id
  ownerType UsernameOwnerType
  ownerId   String
  createdAt DateTime          @default(now())

  @@map("usernames")
}

model Teacher {
  id             String   @id @default(uuid())
  username       String   @unique
  password       String
  fullName       String?
  phone          String?  @unique
  email          String?  @unique
  telegramUserId String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tests                Test[]
  batches              Batch[]
  uploadJobs           UploadJob[]
  teacherOrganisations TeacherOrganisation[]
  studentAssignments   StudentOrganisation[] @relation("AssignedByTeacher")

  @@map("teachers")
}

model Student {
  id        String   @id @default(uuid())
  fullName  String
  phone     String   @unique
  email     String?  @unique
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts             Attempt[]
  batches              BatchStudent[]
  studentOrganisations StudentOrganisation[]

  @@map("students")
}

// ─── Organisations ───────────────────────────────────────────────────────────

model Organisation {
  id             String   @id @default(uuid())
  name           String
  normalizedName String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  teacherOrganisations TeacherOrganisation[]
  studentOrganisations StudentOrganisation[]
  batches              Batch[]

  @@map("organisations")
}

// Composite primary key, matching this codebase's existing pure-join-table
// convention (see BatchStudent below) — no surrogate id column, since
// (teacherId, organisationId) is already the natural, permanent identity of
// this row and nothing ever references it by a separate id.
model TeacherOrganisation {
  teacherId      String
  organisationId String
  createdAt      DateTime @default(now())

  teacher      Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@id([teacherId, organisationId])
  @@index([organisationId])
  @@map("teacher_organisations")
}

model StudentOrganisation {
  studentId           String
  organisationId      String
  assignedByTeacherId String
  createdAt           DateTime @default(now())

  student           Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  organisation      Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  assignedByTeacher Teacher      @relation("AssignedByTeacher", fields: [assignedByTeacherId], references: [id])

  @@id([studentId, organisationId])
  @@index([organisationId])
  // Supports the ON DELETE RESTRICT check on assignedByTeacherId (Postgres
  // must scan for referencing rows before allowing a Teacher delete) and any
  // future "assignments made by this teacher" lookup.
  @@index([assignedByTeacherId])
  @@map("student_organisations")
}

// ─── Batches ─────────────────────────────────────────────────────────────────

model Batch {
  id             String   @id @default(cuid())
  name           String
  teacherId      String
  organisationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  teacher      Teacher       @relation(fields: [teacherId], references: [id])
  organisation Organisation? @relation(fields: [organisationId], references: [id])
  students     BatchStudent[]
  tests        Test[]

  @@index([teacherId])
  @@index([organisationId])
  @@map("batches")
}

model BatchStudent {
  batchId   String
  studentId String
  joinedAt  DateTime @default(now())

  batch   Batch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([batchId, studentId])
  @@index([studentId])
  @@map("batch_students")
}

// ─── Tests ───────────────────────────────────────────────────────────────────

enum TestStatus {
  DRAFT
  SCHEDULED
  COMPLETED
}

model Test {
  id              String     @id @default(uuid())
  name            String
  teacherId       String
  subjectId       String
  batchId         String?
  durationMinutes Int
  scheduledAt     DateTime
  status          TestStatus @default(DRAFT)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  teacher       Teacher        @relation(fields: [teacherId], references: [id])
  subject       Subject        @relation(fields: [subjectId], references: [id])
  batch         Batch?         @relation(fields: [batchId], references: [id])
  testQuestions TestQuestion[]
  attempts      Attempt[]

  @@index([teacherId])
  @@index([batchId])
  @@index([status, scheduledAt])
  @@map("tests")
}

model TestQuestion {
  id                 String       @id @default(uuid())
  testId             String
  originalQuestionId String?
  questionText       String?
  questionImageUrl   String?
  latexContent       String?      @db.Text
  questionType       QuestionType
  optionsJson        Json
  correctAnswerJson  Json
  position           Int
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  test             Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  originalQuestion Question? @relation(fields: [originalQuestionId], references: [id])
  responses        Response[]

  @@unique([testId, position])
  @@index([testId])
  @@index([originalQuestionId])
  @@map("test_questions")
}

// ─── Attempts ─────────────────────────────────────────────────────────────────

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

model Attempt {
  id               String        @id @default(uuid())
  studentId        String
  testId           String
  startedAt        DateTime      @default(now())
  submittedAt      DateTime?
  status           AttemptStatus @default(IN_PROGRESS)
  score            Int?
  correctCount     Int?
  wrongCount       Int?
  unattemptedCount Int?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  student   Student    @relation(fields: [studentId], references: [id])
  test      Test       @relation(fields: [testId], references: [id])
  responses Response[]

  @@unique([studentId, testId])
  @@index([studentId, status])
  @@index([testId])
  @@map("attempts")
}

model Response {
  id                 String    @id @default(uuid())
  attemptId          String
  testQuestionId     String
  selectedAnswerJson Json?
  isCorrect          Boolean?
  answeredAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  attempt      Attempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  testQuestion TestQuestion @relation(fields: [testQuestionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, testQuestionId])
  @@index([attemptId])
  @@index([testQuestionId])
  @@map("responses")
}

// ─── Upload Jobs ──────────────────────────────────────────────────────────────

model UploadJob {
  id                 String          @id @default(uuid())
  teacherId          String
  topicId            String
  uploadSource       UploadSource
  status             UploadJobStatus @default(RECEIVED)
  failedStep         String?
  errorMessage       String?
  cloudinaryPublicId String?
  questionId         String?         @unique
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  resolvedAt         DateTime?

  teacher  Teacher   @relation(fields: [teacherId], references: [id])
  topic    Topic     @relation(fields: [topicId], references: [id])
  question Question? @relation(fields: [questionId], references: [id])

  @@index([status])
  @@index([teacherId])
  @@index([teacherId, status, createdAt])
  @@map("upload_jobs")
}
